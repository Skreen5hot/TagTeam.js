{
  "name": "CCO Complex Sentence Corpus",
  "version": "1.0",
  "date": "2026-04-01",
  "description": "20 complex sentences using CCO vocabulary to stress-test coordination, subordination, relative clauses, passives, negation, multi-word entities, statives, and tense-aspect.",
  "ontology": "dist/cco-merged.ttl",
  "sentences": [
    {
      "id": "COORD-01",
      "sentence": "The organization and the person signed the title document.",
      "pattern": "NP coordination (agent)",
      "expectedEntities": [
        "organization",
        "person",
        "title document"
      ],
      "expectedRoles": [
        {
          "entity": "organization",
          "role": "Agent"
        },
        {
          "entity": "person",
          "role": "Agent"
        },
        {
          "entity": "title document",
          "role": "Patient"
        }
      ],
      "expectedOntologyMatches": [
        "Organization",
        "Person",
        "Title Document"
      ],
      "knownIssues": []
    },
    {
      "id": "COORD-02",
      "sentence": "The person submitted the report and the certificate.",
      "pattern": "NP coordination (patient)",
      "expectedEntities": [
        "person",
        "report",
        "certificate"
      ],
      "expectedRoles": [
        {
          "entity": "person",
          "role": "Agent"
        },
        {
          "entity": "report",
          "role": "Patient"
        },
        {
          "entity": "certificate",
          "role": "Patient"
        }
      ],
      "expectedOntologyMatches": [
        "Person",
        "Report"
      ],
      "knownIssues": [
        "Second conjunct 'certificate' may be dropped by NER"
      ]
    },
    {
