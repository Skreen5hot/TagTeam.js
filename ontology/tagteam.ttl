@prefix : <http://tagteam.fandaws.com/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# TagTeam Semantic Parsing Ontology
# =============================================================================
#
# A unified ontology for domain-neutral semantic parsing that extends
# BFO 2020 (ISO 21838-2:2020) and Common Core Ontologies (CCO).
#
# Provides vocabulary for:
#   - Natural language parsing artifacts (DiscourseReferent, VerbPhrase)
#   - Speech act typing and clause segmentation
#   - Structural assertion provenance (FT-03)
#   - Deontic modality (obligation, permission, prohibition)
#   - Scarcity detection
#   - Actuality status tracking
#   - Ontology match annotations
#   - BFO/CCO bridge properties with near-miss documentation
#
# Consolidates previous tagteam-core (v1.0.0), tagteam-v2 (v2.0.0),
# and tagteam-v3 (v3.0.0) into a single authoritative file.
#
# Version: 4.1.0
# License: CC-BY-4.0
# =============================================================================

<http://tagteam.fandaws.com/ontology/>
    a owl:Ontology ;
    owl:versionIRI <http://tagteam.fandaws.com/ontology/4.1.0/> ;
    owl:versionInfo "4.1.0"^^xsd:string ;
    dc:title "TagTeam Semantic Parsing Ontology"@en ;
    dc:description "A unified ontology for domain-neutral semantic parsing with BFO/CCO alignment. Provides vocabulary for parsing artifacts, speech acts, clause segmentation, structural assertions, deontic modality, scarcity detection, and ontology matching."@en ;
    dc:creator "TagTeam Development Team"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2024-01-01"^^xsd:date ;
    dcterms:modified "2026-03-06"^^xsd:date ;
    rdfs:comment "Consolidated from tagteam-core v1.0.0, tagteam-v2 v2.0.0, and tagteam-v3 v3.0.0. Values/ethical layer removed in v4.0.0; see packages/iee-values/ for standalone reference."@en ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ,
                <https://www.commoncoreontologies.org/> .


# =============================================================================
# CLASSES — Tier 1 Parsing Layer (Information Content Entities)
# =============================================================================

:DiscourseReferent
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Discourse Referent"@en ;
    skos:prefLabel "Discourse Referent"@en ;
    skos:definition "A Tier 1 information content entity that represents a mention of an entity in discourse. Links to its Tier 2 real-world referent via cco:is_about."@en ;
    rdfs:comment "In the two-tier architecture, DiscourseReferents (Tier 1) are linked to real-world entities like cco:Person (Tier 2) via the denotesType property."@en ;
    skos:example "The text 'the doctor' creates a DiscourseReferent that denotesType cco:Person."@en .

:VerbPhrase
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Verb Phrase"@en ;
    skos:prefLabel "Verb Phrase"@en ;
    skos:definition "An information content entity that denotes a linguistic unit expressing an action, state, or occurrence along with its associated temporal, aspectual, and modal properties."@en .

:DeonticContent
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Deontic Content"@en ;
    skos:prefLabel "Deontic Content"@en ;
    skos:definition "An information content entity that denotes normative propositions expressing obligations, permissions, prohibitions, or recommendations."@en ;
    rdfs:comment "Parent class for all normative/prescriptive content. Per CCO Expert Review: DeonticContent is the broader category; DirectiveContent is a specific subclass for imperatives."@en .

:DirectiveContent
    a owl:Class ;
    rdfs:subClassOf :DeonticContent, cco:InformationContentEntity ;
    rdfs:label "Directive Content"@en ;
    skos:prefLabel "Directive Content"@en ;
    skos:definition "DEPRECATED — Superseded by DirectiveInformationContentEntity (RDM v1.2.1). The old DirectiveContent emitted IntentionalAct nodes for modal verbs (ghost acts). Retained for backward compatibility with pre-RDM consumers."@en ;
    rdfs:comment "Subclass of DeonticContent for explicit directives. Also aligned with cco:InformationContentEntity for CCO compatibility."@en .

:ScarcityAssertion
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Scarcity Assertion"@en ;
    skos:prefLabel "Scarcity Assertion"@en ;
    skos:definition "An information content entity that denotes the insufficient availability of a resource relative to demand for that resource."@en ;
    skos:example "The phrase 'the last ventilator' triggers creation of a ScarcityAssertion."@en .

:InterpretationContext
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Interpretation Context"@en ;
    skos:prefLabel "Interpretation Context"@en ;
    skos:definition "An information content entity that denotes a framework of principles, standards, or perspectives that guides the understanding and evaluation of assertions, such as medical ethics or legal doctrine."@en ;
    skos:example "MedicalEthics context uses Beauchamp & Childress Principlism framework."@en .


# =============================================================================
# CLASSES — Speech Acts
# =============================================================================

:SpeechAct
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Speech Act"@en ;
    skos:prefLabel "Speech Act"@en ;
    skos:definition "An information content entity that denotes the illocutionary force of an utterance."@en .

:Inquiry
    a owl:Class ;
    rdfs:subClassOf :SpeechAct ;
    rdfs:label "Inquiry"@en ;
    skos:prefLabel "Inquiry"@en ;
    skos:definition "A speech act that requests information by wrapping an interrogative act."@en .

:ConditionalContent
    a owl:Class ;
    rdfs:subClassOf :SpeechAct ;
    rdfs:label "Conditional Content"@en ;
    skos:prefLabel "Conditional Content"@en ;
    skos:definition "A speech act that denotes a condition-consequence relationship where the truth or occurrence of one proposition depends upon the truth or occurrence of another proposition."@en .


# =============================================================================
# CLASSES — Structural
# =============================================================================

:ClauseRelation
    a owl:Class ;
    rdfs:label "Clause Relation"@en ;
    skos:prefLabel "Clause Relation"@en ;
    skos:definition "A structural connection that links two grammatical units within a compound or complex sentence."@en .

:CausativeAct
    a owl:Class ;
    rdfs:subClassOf cco:IntentionalAct ;
    rdfs:label "Causative Act"@en ;
    skos:prefLabel "Causative Act"@en ;
    skos:definition "An intentional behavior that brings about another agent's performance of an action."@en .

:StructuralAssertion
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Structural Assertion"@en ;
    skos:prefLabel "Structural Assertion"@en ;
    skos:definition "A detected structural relation between entities from copular or stative sentence patterns. Serves as Tier 1 provenance for the corresponding Tier 2 inter-entity triple."@en .

:NegatedStructuralAssertion
    a owl:Class ;
    rdfs:subClassOf :StructuralAssertion ;
    rdfs:label "Negated Structural Assertion"@en ;
    skos:prefLabel "Negated Structural Assertion"@en ;
    skos:definition "A detected structural relation that the text explicitly denies. Corresponds to an owl:NegativePropertyAssertion on Tier 2."@en .


# =============================================================================
# CLASSES — Actuality Status (Deontic/Temporal)
# =============================================================================

:ActualityStatus
    a owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Actuality Status"@en ;
    skos:prefLabel "Actuality Status"@en ;
    skos:definition "An Information Content Entity that denotes the modal condition of an act with respect to its realization in reality."@en .

:Actual
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Actual"@en ;
    skos:prefLabel "Actual"@en ;
    skos:definition "An actuality status that denotes the occurrence or current occurrence of an act in reality."@en .

:Prescribed
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Prescribed"@en ;
    skos:prefLabel "Prescribed"@en ;
    skos:definition "An actuality status that denotes the deontic necessity of some act or state of affairs."@en ;
    rdfs:comment "Corresponds to modal markers like 'must', 'should', 'ought to'."@en .

:Permitted
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Permitted"@en ;
    skos:prefLabel "Permitted"@en ;
    skos:definition "An actuality status that denotes a deontic modality wherein an act is allowed but not required."@en ;
    rdfs:comment "Corresponds to modal markers like 'may', 'can', 'is allowed to'."@en .

:Prohibited
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Prohibited"@en ;
    skos:prefLabel "Prohibited"@en ;
    skos:definition "An actuality status that denotes the deontic impossibility of some act or state of affairs."@en ;
    rdfs:comment "Corresponds to modal markers like 'must not', 'shall not', 'is forbidden to'."@en .

:Hypothetical
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Hypothetical"@en ;
    skos:prefLabel "Hypothetical"@en ;
    skos:definition "An actuality status that denotes a state of affairs as being considered or discussed as a possibility rather than being asserted as actual."@en ;
    rdfs:comment "Corresponds to conditional constructions like 'if...then', 'would'."@en .

:Planned
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Planned"@en ;
    skos:prefLabel "Planned"@en ;
    skos:definition "An actuality status that denotes an act is intended for future execution but has not yet been initiated."@en ;
    rdfs:comment "Corresponds to intention markers like 'will', 'intend to', 'plan to'."@en .

:Negated
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Negated"@en ;
    skos:prefLabel "Negated"@en ;
    skos:definition "An actuality status that denotes the explicit denial or contradiction of an act's occurrence in the text."@en ;
    rdfs:comment "Corresponds to negation markers like 'not', 'never', 'won't'."@en .

:Interrogative
    a owl:NamedIndividual, :ActualityStatus ;
    rdfs:label "Interrogative"@en ;
    skos:prefLabel "Interrogative"@en ;
    skos:definition "An actuality status that denotes the event is being questioned."@en .


# =============================================================================
# NAMED INDIVIDUALS — Default Context
# =============================================================================

:Default_Context
    a owl:NamedIndividual, :InterpretationContext ;
    rdfs:label "Default Context"@en ;
    skos:prefLabel "Default Context"@en ;
    skos:definition "An interpretive framework automatically applied to assertions when no specific alternative framework is designated."@en .


# =============================================================================
# NAMED INDIVIDUALS — Clause Relation Types
# =============================================================================

:and_then
    a owl:NamedIndividual, :ClauseRelation ;
    rdfs:label "and then"@en ;
    skos:prefLabel "and then"@en ;
    skos:definition "A clause relation denoting sequential coordination where clause A is followed by clause B."@en .

:therefore
    a owl:NamedIndividual, :ClauseRelation ;
    rdfs:label "therefore"@en ;
    skos:prefLabel "therefore"@en ;
    skos:definition "A clause relation denoting that clause B is a consequence of clause A."@en .

:in_order_that
    a owl:NamedIndividual, :ClauseRelation ;
    rdfs:label "in order that"@en ;
    skos:prefLabel "in order that"@en ;
    skos:definition "A clause relation denoting a purposive connection where one clause expresses the goal or intended outcome of another clause."@en .

:contrasts_with
    a owl:NamedIndividual, :ClauseRelation ;
    rdfs:label "contrasts with"@en ;
    skos:prefLabel "contrasts with"@en ;
    skos:definition "A clause relation denoting that clause B presents information that differs from or opposes the information presented in clause A."@en .

:alternative_to
    a owl:NamedIndividual, :ClauseRelation ;
    rdfs:label "alternative to"@en ;
    skos:prefLabel "alternative to"@en ;
    skos:definition "A clause relation denoting that clause B is a substitute option for clause A."@en .


# =============================================================================
# NAMED INDIVIDUALS — Temporal Relations
# =============================================================================

:precedes
    a owl:NamedIndividual ;
    rdfs:label "precedes"@en ;
    skos:prefLabel "precedes"@en ;
    skos:definition "A temporal relation denoting that the source event occurs before the target event."@en .

:follows
    a owl:NamedIndividual ;
    rdfs:label "follows"@en ;
    skos:prefLabel "follows"@en ;
    skos:definition "A temporal relation denoting that the source event occurs after the target event."@en .

:simultaneous_with
    a owl:NamedIndividual ;
    rdfs:label "simultaneous with"@en ;
    skos:prefLabel "simultaneous with"@en ;
    skos:definition "A temporal relation denoting that the events occur at the same time."@en .


# =============================================================================
# OBJECT PROPERTIES — BFO Bridged (Audit §3.3)
# =============================================================================

:has_function
    a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000196 ;  # BFO 2020 bearer_of
    rdfs:label "has function"@en ;
    skos:prefLabel "has function"@en ;
    skos:definition "An object property relating an independent continuant to a function that inheres in it."@en .


# =============================================================================
# OBJECT PROPERTIES — Domain-Specific (Audit §3–4, §8)
# =============================================================================

:would_be_realized_in
    a owl:ObjectProperty ;
    rdfs:label "would be realized in"@en ;
    skos:prefLabel "would be realized in"@en ;
    skos:definition "An object property relating a realizable entity to a process type in which it would be realized under counterfactual conditions."@en ;
    skos:scopeNote "Denotes counterfactual realization. BFO realizes/realized_in is reserved for actual events only."@en ;
    rdfs:comment """USAGE CONSTRAINT (per CCO Expert Review):
This property MUST ONLY be used when the target process has an actualityStatus
other than :Actual (i.e., :Prescribed, :Permitted, :Prohibited, :Hypothetical,
:Planned, or :Negated). Using this property with an :Actual process violates
BFO's principle that bfo:realized_in should be used for actual realizations.

Correct usage:
  - Role links via :would_be_realized_in to a Prescribed act
  - Role links via bfo:realized_in to an Actual act

This prevents over-generation of potentiality in factual graphs."""@en ;
    rdfs:domain bfo:BFO_0000023 ;  # role
    rdfs:range bfo:BFO_0000015 .   # process

:extracted_from
    a owl:ObjectProperty ;
    rdfs:label "extracted from"@en ;
    skos:prefLabel "extracted from"@en ;
    skos:definition "An object property relating a parse artifact to the source text span from which it was produced by an NLP process."@en ;
    rdfs:domain cco:InformationContentEntity ;
    rdfs:range :DiscourseReferent .

:has_component
    a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    skos:prefLabel "has component"@en ;
    skos:definition "An object property relating a linguistic structure to a constituent grammatical unit it contains."@en ;
    skos:scopeNote "Denotes linguistic or structural composition (e.g., VerbPhrase contains NounPhrase). STRICTLY NOT BFO mereological parthood (has_continuant_part BFO_0000178)."@en ;
    rdfs:domain cco:InformationContentEntity ;
    rdfs:range cco:InformationContentEntity .

:supersedes
    a owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    skos:prefLabel "supersedes"@en ;
    skos:definition "An object property relating a document or validation record to the prior version it replaces."@en ;
    skos:scopeNote "Denotes document or validation record versioning. Distinct from CCO is_successor_of (cco:ont00001775), which implies a manufacturing/process chain."@en .

:describes_quality
    a owl:ObjectProperty ;
    rdfs:label "describes quality"@en ;
    skos:prefLabel "describes quality"@en ;
    skos:definition "An object property relating a discourse referent to the quality it characterizes in the source text."@en ;
    skos:scopeNote "Links a DiscourseReferent to a Quality. Distinct from CCO describes (cco:ont00001982), which has domain DescriptiveICE."@en ;
    rdfs:comment """Phase 5 Addition (per CCO Expert Review):
This property enables mapping from linguistic qualifiers to formal BFO qualities.
For example, 'critically ill patient' would have:
  - DiscourseReferent for 'patient' with :describes_quality linking to
  - bfo:Quality that inheres in the Patient

This is essential for reasoning about the physical states described by adjectives,
not just recording them as text strings in :qualifierText."""@en ;
    rdfs:domain :DiscourseReferent ;
    rdfs:range bfo:BFO_0000019 .  # quality

:corefersWith
    a owl:ObjectProperty ;
    rdfs:label "corefers with"@en ;
    skos:prefLabel "corefers with"@en ;
    skos:definition "An object property that relates two discourse referents that denote the same entity."@en ;
    rdfs:domain :DiscourseReferent ;
    rdfs:range :DiscourseReferent ;
    rdf:type owl:SymmetricProperty .


# =============================================================================
# OBJECT PROPERTIES — Role and Act Relations
# =============================================================================

:actualityStatus
    a owl:ObjectProperty ;
    rdfs:label "actuality status"@en ;
    skos:prefLabel "actuality status"@en ;
    skos:definition "An object property that relates an act to a quality that specifies the modal nature of that act."@en ;
    rdfs:domain bfo:BFO_0000015 ;  # process
    rdfs:range :ActualityStatus .

:prescribes
    a owl:ObjectProperty ;
    rdfs:label "prescribes"@en ;
    skos:prefLabel "prescribes"@en ;
    skos:definition "Links a DirectiveInformationContentEntity to the PlanSpecification it prescribes. (RDM v1.2.1: domain updated from DirectiveContent to DICE, range from Process to PlanSpecification.)"@en ;
    rdfs:subPropertyOf cco:prescribes ;
    rdfs:domain :DirectiveInformationContentEntity ;
    rdfs:range :PlanSpecification ;
    owl:inverseOf :prescribed_by .

:prescribed_by
    a owl:ObjectProperty ;
    rdfs:label "prescribed by"@en ;
    skos:prefLabel "prescribed by"@en ;
    skos:definition "Inverse of prescribes. Links a PlanSpecification to the DICE that prescribed it."@en ;
    rdfs:domain :PlanSpecification ;
    rdfs:range :DirectiveInformationContentEntity ;
    owl:inverseOf :prescribes .


# =============================================================================
# OBJECT PROPERTIES — Scarcity Relations
# =============================================================================

:scarceResource
    a owl:ObjectProperty ;
    rdfs:label "scarce resource"@en ;
    skos:prefLabel "scarce resource"@en ;
    skos:definition "An object property that relates a scarcity assertion to a material entity that is in limited supply."@en ;
    rdfs:domain :ScarcityAssertion ;
    rdfs:range bfo:BFO_0000030 .  # object

:competingParties
    a owl:ObjectProperty ;
    rdfs:label "competing parties"@en ;
    skos:prefLabel "competing parties"@en ;
    skos:definition "An object property that relates a scarcity assertion to the agents that are in competition for the scarce resource."@en ;
    rdfs:domain :ScarcityAssertion ;
    rdfs:range cco:Agent .


# =============================================================================
# OBJECT PROPERTIES — Provenance
# =============================================================================

:instantiated_by
    a owl:ObjectProperty ;
    rdfs:label "instantiated by"@en ;
    skos:prefLabel "instantiated by"@en ;
    skos:definition "An object property that relates an entity to the agent or document that brought it into existence."@en ;
    rdfs:range cco:InformationBearingEntity .


# =============================================================================
# OBJECT PROPERTIES — Clause Relations
# =============================================================================

:relationType
    a owl:ObjectProperty ;
    rdfs:label "relation type"@en ;
    skos:prefLabel "relation type"@en ;
    skos:definition "An object property that links a clause connection to its semantic category, such as sequential, causal, or contrastive."@en ;
    rdfs:domain :ClauseRelation .

:fromClause
    a owl:ObjectProperty ;
    rdfs:label "from clause"@en ;
    skos:prefLabel "from clause"@en ;
    skos:definition "An object property that relates a relational entity to its source linguistic act."@en ;
    rdfs:domain :ClauseRelation .

:toClause
    a owl:ObjectProperty ;
    rdfs:label "to clause"@en ;
    skos:prefLabel "to clause"@en ;
    skos:definition "An object property that relates a conditional statement to its consequent linguistic act."@en ;
    rdfs:domain :ClauseRelation .

:has_antecedent
    a owl:ObjectProperty ;
    rdfs:label "has antecedent"@en ;
    skos:prefLabel "has antecedent"@en ;
    skos:definition "An object property that relates a conditional information content entity to the information content entity that denotes the condition upon which the conditional depends."@en ;
    rdfs:domain :ConditionalContent .

:has_consequent
    a owl:ObjectProperty ;
    rdfs:label "has consequent"@en ;
    skos:prefLabel "has consequent"@en ;
    skos:definition "An object property that relates a conditional information content entity to the information content entity that denotes what follows when the conditional's antecedent condition is satisfied."@en ;
    rdfs:domain :ConditionalContent .

:has_cause
    a owl:ObjectProperty ;
    rdfs:label "has cause"@en ;
    skos:prefLabel "has cause"@en ;
    skos:definition "An object property that relates a mental process to the entity that causally brings about that mental process."@en .


# =============================================================================
# OBJECT PROPERTIES — FT-03 Structural Assertion Provenance
# =============================================================================

:assertionSubject
    a owl:ObjectProperty ;
    rdfs:label "assertion subject"@en ;
    skos:prefLabel "assertion subject"@en ;
    skos:definition "The Tier 1 DiscourseReferent that served as the linguistic subject of a detected structural assertion."@en ;
    rdfs:domain :StructuralAssertion ;
    rdfs:range :DiscourseReferent .

:assertionObject
    a owl:ObjectProperty ;
    rdfs:label "assertion object"@en ;
    skos:prefLabel "assertion object"@en ;
    skos:definition "The Tier 1 DiscourseReferent that served as the linguistic object of a detected structural assertion."@en ;
    rdfs:domain :StructuralAssertion ;
    rdfs:range :DiscourseReferent .


# =============================================================================
# DATATYPE PROPERTIES — Provenance and Timestamps
# =============================================================================

:instantiated_at
    a owl:DatatypeProperty ;
    rdfs:label "instantiated at"@en ;
    skos:prefLabel "instantiated at"@en ;
    skos:definition "A datatype property that denotes the timestamp when an entity was created in the graph."@en ;
    rdfs:range xsd:dateTime .

:detected_at
    a owl:DatatypeProperty ;
    rdfs:label "detected at"@en ;
    skos:prefLabel "detected at"@en ;
    skos:definition "The timestamp when a detection (e.g., scarcity) was made."@en ;
    rdfs:range xsd:dateTime .

:received_at
    a owl:DatatypeProperty ;
    rdfs:label "received at"@en ;
    skos:prefLabel "received at"@en ;
    skos:definition "A temporal instant that denotes when input text arrived for processing."@en ;
    rdfs:domain cco:InformationBearingEntity ;
    rdfs:range xsd:dateTime .

:temporal_extent
    a owl:DatatypeProperty ;
    rdfs:label "temporal extent"@en ;
    skos:prefLabel "temporal extent"@en ;
    skos:definition "A datatype property that denotes the duration of time during which an entity exists or a process occurs."@en ;
    rdfs:range xsd:dateTime .

:has_start_time
    a owl:DatatypeProperty ;
    rdfs:label "has start time"@en ;
    skos:prefLabel "has start time"@en ;
    skos:definition "A datatype property relating a process or temporal entity to its beginning instant expressed as an xsd:dateTime literal."@en ;
    rdfs:range xsd:dateTime ;
    skos:scopeNote "NLP extraction property. Distinct from BFO has_first_instant (BFO_0000222), which is an owl:ObjectProperty pointing to a TemporalInstant individual."@en .

:has_end_time
    a owl:DatatypeProperty ;
    rdfs:label "has end time"@en ;
    skos:prefLabel "has end time"@en ;
    skos:definition "A datatype property relating a process or temporal entity to its ending instant expressed as an xsd:dateTime literal."@en ;
    rdfs:range xsd:dateTime ;
    skos:scopeNote "NLP extraction property. Distinct from BFO has_last_instant (BFO_0000224), which is an owl:ObjectProperty pointing to a TemporalInstant individual."@en .


# =============================================================================
# DATATYPE PROPERTIES — Text and Position
# =============================================================================

:sourceText
    a owl:DatatypeProperty ;
    rdfs:label "source text"@en ;
    skos:prefLabel "source text"@en ;
    skos:definition "A datatype property that denotes the original character sequence from which an entity originates."@en ;
    rdfs:range xsd:string .

:startPosition
    a owl:DatatypeProperty ;
    rdfs:label "start position"@en ;
    skos:prefLabel "start position"@en ;
    skos:definition "The character offset where the source text begins in the input."@en ;
    rdfs:range xsd:integer .

:endPosition
    a owl:DatatypeProperty ;
    rdfs:label "end position"@en ;
    skos:prefLabel "end position"@en ;
    skos:definition "A datatype property that denotes the character offset where the source text concludes in the input."@en ;
    rdfs:range xsd:integer .

:char_count
    a owl:DatatypeProperty ;
    rdfs:label "character count"@en ;
    skos:prefLabel "character count"@en ;
    skos:definition "A datatype property that denotes the quantity of individual symbols contained within a specified textual entity."@en ;
    rdfs:domain cco:InformationBearingEntity ;
    rdfs:range xsd:integer .

:word_count
    a owl:DatatypeProperty ;
    rdfs:label "word count"@en ;
    skos:prefLabel "word count"@en ;
    skos:definition "A datatype property that denotes the quantity of lexical units in a given textual input."@en ;
    rdfs:domain cco:InformationBearingEntity ;
    rdfs:range xsd:integer .

:extracted_from_span
    a owl:DatatypeProperty ;
    rdfs:label "extracted from span"@en ;
    skos:prefLabel "extracted from span"@en ;
    skos:definition "A datatype property that relates an entity to the text segment that is the source of that entity."@en ;
    rdfs:range xsd:string .

:span_offset
    a owl:DatatypeProperty ;
    rdfs:label "span offset"@en ;
    skos:prefLabel "span offset"@en ;
    skos:definition "A datatype property that denotes the start and end character positions of a text segment, expressed as a pair of integers."@en ;
    rdfs:comment "Stored as a JSON array [start, end] in JSON-LD."@en ;
    rdfs:range xsd:string .


# =============================================================================
# DATATYPE PROPERTIES — Discourse Referent Attributes
# =============================================================================

:denotesType
    a owl:DatatypeProperty ;
    rdfs:label "denotes type"@en ;
    skos:prefLabel "denotes type"@en ;
    skos:definition "A datatype property that relates a discourse referent to the IRI of the ontology class that the discourse referent refers to."@en ;
    rdfs:domain :DiscourseReferent ;
    rdfs:range xsd:string .

:referentialStatus
    a owl:DatatypeProperty ;
    rdfs:label "referential status"@en ;
    skos:prefLabel "referential status"@en ;
    skos:definition "A datatype property that denotes the discourse accessibility of an entity mentioned in text, with values indicating whether the entity is presupposed as known, newly introduced, referenced anaphorically, or presented hypothetically."@en ;
    rdfs:domain :DiscourseReferent ;
    rdfs:range xsd:string .

:definiteness
    a owl:DatatypeProperty ;
    rdfs:label "definiteness"@en ;
    skos:prefLabel "definiteness"@en ;
    skos:definition "A datatype property that denotes whether a linguistic referent has definite or indefinite determination."@en ;
    rdfs:domain :DiscourseReferent ;
    rdfs:range xsd:string .

:quantity
    a owl:DatatypeProperty ;
    rdfs:label "quantity"@en ;
    skos:prefLabel "quantity"@en ;
    skos:definition "A datatype property that denotes the numeric value indicating how many entities are being referenced."@en ;
    rdfs:range xsd:integer .

:quantityIndicator
    a owl:DatatypeProperty ;
    rdfs:label "quantity indicator"@en ;
    skos:prefLabel "quantity indicator"@en ;
    skos:definition "A linguistic marker that denotes the amount or number of entities being referenced."@en ;
    rdfs:range xsd:string .

:qualifiers
    a owl:DatatypeProperty ;
    rdfs:label "qualifiers"@en ;
    skos:prefLabel "qualifiers"@en ;
    skos:definition "A datatype property that denotes adjective or adverbial modifiers associated with an entity."@en ;
    rdfs:range xsd:string .


# =============================================================================
# DATATYPE PROPERTIES — Role and Act Attributes
# =============================================================================

:roleType
    a owl:DatatypeProperty ;
    rdfs:label "role type"@en ;
    skos:prefLabel "role type"@en ;
    skos:definition "A datatype property that denotes the semantic function performed by a participant in a linguistic or conceptual relation."@en ;
    rdfs:domain bfo:BFO_0000023 ;
    rdfs:range xsd:string .

:verb
    a owl:DatatypeProperty ;
    rdfs:label "verb"@en ;
    skos:prefLabel "verb"@en ;
    skos:definition "A datatype property that denotes the infinitive form of an action word within a linguistic act or expression."@en ;
    rdfs:range xsd:string .

:lemma
    a owl:DatatypeProperty ;
    rdfs:label "lemma"@en ;
    skos:prefLabel "lemma"@en ;
    skos:definition "A datatype property that denotes the canonical or dictionary form of a lexical item from which inflected variants are derived."@en ;
    rdfs:range xsd:string .

:tense
    a owl:DatatypeProperty ;
    rdfs:label "tense"@en ;
    skos:prefLabel "tense"@en ;
    skos:definition "A datatype property that denotes the temporal relationship between the time of an action or state and the time of speaking or reference point in a grammatical expression."@en ;
    rdfs:range xsd:string .

:aspect
    a owl:DatatypeProperty ;
    rdfs:label "aspect"@en ;
    skos:prefLabel "aspect"@en ;
    skos:definition "A datatype property that denotes the temporal structure or completion status of a verbal action or state."@en ;
    rdfs:range xsd:string .

:negated
    a owl:DatatypeProperty ;
    rdfs:label "negated"@en ;
    skos:prefLabel "negated"@en ;
    skos:definition "A datatype property that denotes whether a linguistic expression or action has opposite or contrary meaning to its positive form."@en ;
    rdfs:range xsd:boolean .

:negationMarker
    a owl:DatatypeProperty ;
    rdfs:label "negation marker"@en ;
    skos:prefLabel "negation marker"@en ;
    skos:definition "A datatype property that denotes linguistic elements which indicate the absence or contradiction of a stated condition."@en ;
    rdfs:range xsd:string .

:hasModalMarker
    a owl:DatatypeProperty ;
    rdfs:label "has modal marker"@en ;
    skos:prefLabel "has modal marker"@en ;
    skos:definition "A datatype property that denotes whether a linguistic expression contains an auxiliary verb indicating possibility, necessity, or obligation."@en ;
    rdfs:range xsd:boolean .


# =============================================================================
# DATATYPE PROPERTIES — Deontic Modal Attributes
# =============================================================================

:modality
    a owl:DatatypeProperty ;
    rdfs:label "modality"@en ;
    skos:prefLabel "modality"@en ;
    skos:definition "A datatype property that denotes the deontic status of a statement as obligation, permission, prohibition, recommendation, intention, or hypothetical."@en ;
    rdfs:range xsd:string .

:modalType
    a owl:DatatypeProperty ;
    rdfs:label "modal type"@en ;
    skos:prefLabel "modal type"@en ;
    skos:definition "A datatype property that denotes the category of necessity, possibility, or obligation expressed by a linguistic construction."@en ;
    rdfs:range xsd:string .

:modalMarker
    a owl:DatatypeProperty ;
    rdfs:label "modal marker"@en ;
    skos:prefLabel "modal marker"@en ;
    skos:definition "A datatype property that denotes linguistic expressions indicating modality such as necessity, possibility, or obligation."@en ;
    rdfs:range xsd:string .

:modalStrength
    a owl:DatatypeProperty ;
    rdfs:label "modal strength"@en ;
    skos:prefLabel "modal strength"@en ;
    skos:definition "A datatype property that denotes the degree of deontic force expressed by an obligation or prohibition on a scale from 0.0 to 1.0, where 1.0 indicates the highest degree of binding force."@en ;
    rdfs:range xsd:decimal .


# =============================================================================
# DATATYPE PROPERTIES — Scarcity Attributes
# =============================================================================

:is_scarce
    a owl:DatatypeProperty ;
    rdfs:label "is scarce"@en ;
    skos:prefLabel "is scarce"@en ;
    skos:definition "A datatype property that denotes whether an entity has limited availability or insufficient quantity based on linguistic markers."@en ;
    rdfs:range xsd:boolean .

:scarcity_marker
    a owl:DatatypeProperty ;
    rdfs:label "scarcity marker"@en ;
    skos:prefLabel "scarcity marker"@en ;
    skos:definition "A linguistic expression that denotes the limited availability or restricted quantity of some entity."@en ;
    rdfs:range xsd:string .

:scarcityMarker
    a owl:DatatypeProperty ;
    rdfs:label "scarcity marker"@en ;
    skos:prefLabel "scarcity marker"@en ;
    owl:equivalentProperty :scarcity_marker ;
    skos:definition "A datatype property that denotes the degree of rarity or limited availability of some entity within a specified context."@en ;
    rdfs:range xsd:string .

:supplyCount
    a owl:DatatypeProperty ;
    rdfs:label "supply count"@en ;
    skos:prefLabel "supply count"@en ;
    skos:definition "A quantity that denotes the number of available units of a scarce resource at a specific time."@en ;
    rdfs:domain :ScarcityAssertion ;
    rdfs:range xsd:integer .

:demandCount
    a owl:DatatypeProperty ;
    rdfs:label "demand count"@en ;
    skos:prefLabel "demand count"@en ;
    skos:definition "A non-negative integer that denotes the number of parties requiring a particular scarce resource in a specific context."@en ;
    rdfs:domain :ScarcityAssertion ;
    rdfs:range xsd:integer .

:scarcityRatio
    a owl:DatatypeProperty ;
    rdfs:label "scarcity ratio"@en ;
    skos:prefLabel "scarcity ratio"@en ;
    skos:definition "A measurement datum that denotes the quotient of available supply to demand for a resource when that resource is limited in availability."@en ;
    rdfs:domain :ScarcityAssertion ;
    rdfs:range xsd:decimal .


# =============================================================================
# DATATYPE PROPERTIES — Quality Attributes
# =============================================================================

:qualifierText
    a owl:DatatypeProperty ;
    rdfs:label "qualifier text"@en ;
    skos:prefLabel "qualifier text"@en ;
    skos:definition "A textual information content entity that denotes a modifying characteristic or condition that specifies or limits the meaning of another entity."@en ;
    rdfs:range xsd:string .

:severity
    a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    skos:prefLabel "severity"@en ;
    skos:definition "A datatype property that denotes the degree of intensity or seriousness of a medical condition or symptom."@en ;
    rdfs:range xsd:string .

:ageCategory
    a owl:DatatypeProperty ;
    rdfs:label "age category"@en ;
    skos:prefLabel "age category"@en ;
    skos:definition "A datatype property that denotes the life stage classification of a person based on their chronological maturity."@en ;
    rdfs:range xsd:string .


# =============================================================================
# DATATYPE PROPERTIES — Object Aggregate Attributes
# =============================================================================

:member_count
    a owl:DatatypeProperty ;
    rdfs:label "member count"@en ;
    skos:prefLabel "member count"@en ;
    skos:definition "A datatype property that denotes the quantity of constituent entities within an object aggregate."@en ;
    rdfs:domain bfo:BFO_0000027 ;  # object aggregate
    rdfs:range xsd:integer .

:member_index
    a owl:DatatypeProperty ;
    rdfs:label "member index"@en ;
    skos:prefLabel "member index"@en ;
    skos:definition "A datatype property that denotes the ordinal position of a constituent within an object aggregate using one-based numbering."@en ;
    rdfs:range xsd:integer .


# =============================================================================
# DATATYPE PROPERTIES — Parser Agent Attributes
# =============================================================================

:version
    a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    skos:prefLabel "version"@en ;
    skos:definition "A datatype property that denotes an alphanumeric identifier indicating the release or iteration number of a software tool or knowledge organization system."@en ;
    rdfs:range xsd:string .

:algorithm
    a owl:DatatypeProperty ;
    rdfs:label "algorithm"@en ;
    skos:prefLabel "algorithm"@en ;
    skos:definition "An information content entity that denotes a systematic procedure for solving a computational problem or performing a specific task."@en ;
    rdfs:range xsd:string .

:capabilities
    a owl:DatatypeProperty ;
    rdfs:label "capabilities"@en ;
    skos:prefLabel "capabilities"@en ;
    skos:definition "A datatype property that denotes the functional abilities possessed by a parser agent."@en ;
    rdfs:range xsd:string .


# =============================================================================
# DATATYPE PROPERTIES — Context Framework
# =============================================================================

:framework
    a owl:DatatypeProperty ;
    rdfs:label "framework"@en ;
    skos:prefLabel "framework"@en ;
    skos:definition "A datatype property that denotes the interpretive approach associated with a particular context."@en ;
    rdfs:domain :InterpretationContext ;
    rdfs:range xsd:string .


# =============================================================================
# DATATYPE PROPERTIES — Budget Tracking
# =============================================================================

:budgetUsage
    a owl:DatatypeProperty ;
    rdfs:label "budget usage"@en ;
    skos:prefLabel "budget usage"@en ;
    skos:definition "A datatype property that denotes the amount of computational resources consumed during graph construction processes."@en ;
    rdfs:range xsd:string .

:truncated
    a owl:DatatypeProperty ;
    rdfs:label "truncated"@en ;
    skos:prefLabel "truncated"@en ;
    skos:definition "A datatype property that denotes whether a graph was cut short due to budget constraints."@en ;
    rdfs:range xsd:boolean .

:budgetWarnings
    a owl:DatatypeProperty ;
    rdfs:label "budget warnings"@en ;
    skos:prefLabel "budget warnings"@en ;
    skos:definition "A datatype property that denotes alert messages produced during computational complexity resource allocation monitoring."@en ;
    rdfs:range xsd:string .


# =============================================================================
# DATATYPE PROPERTIES — Clause Segmentation (v2 extensions)
# =============================================================================

:clauseIndex
    a owl:DatatypeProperty ;
    rdfs:label "clause index"@en ;
    skos:prefLabel "clause index"@en ;
    skos:definition "A datatype property that denotes a zero-based numerical position identifying which grammatical unit an act belongs to in a multi-unit sentence."@en ;
    rdfs:range xsd:integer .

:subjectSource
    a owl:DatatypeProperty ;
    rdfs:label "subject source"@en ;
    skos:prefLabel "subject source"@en ;
    skos:definition "A datatype property that denotes the method by which a grammatical topic was determined for a linguistic expression."@en ;
    rdfs:range xsd:string .

:whPhrase
    a owl:DatatypeProperty ;
    rdfs:label "Wh-phrase"@en ;
    skos:prefLabel "Wh-phrase"@en ;
    skos:definition "A datatype property that denotes the original interrogative phrase from a question before normalization."@en ;
    rdfs:range xsd:string .

:verbClass
    a owl:DatatypeProperty ;
    rdfs:label "verb class"@en ;
    skos:prefLabel "verb class"@en ;
    skos:definition "A datatype property that denotes the grammatical category classification of action words, such as psychological, raising, or causative types."@en ;
    rdfs:range xsd:string .

:epistemicStatus
    a owl:DatatypeProperty ;
    rdfs:label "epistemic status"@en ;
    skos:prefLabel "epistemic status"@en ;
    skos:definition "A datatype property that denotes a qualification concerning the degree of certainty or confidence associated with a proposition or belief state."@en ;
    rdfs:range xsd:string .

:isQuestionFocus
    a owl:DatatypeProperty ;
    rdfs:label "is question focus"@en ;
    skos:prefLabel "is question focus"@en ;
    skos:definition "A datatype property that indicates the entity is the primary subject of inquiry in an interrogative statement."@en ;
    rdfs:range xsd:boolean .


# =============================================================================
# ANNOTATION PROPERTIES — Structural Ambiguity
# =============================================================================

:structuralAmbiguity
    a owl:AnnotationProperty ;
    rdfs:label "structural ambiguity"@en ;
    skos:prefLabel "structural ambiguity"@en ;
    skos:definition "An annotation that flags a node as having unresolved structural ambiguity from the v2 pre-processing layer."@en .

:assertedRelation
    a owl:AnnotationProperty ;
    rdfs:label "asserted relation"@en ;
    skos:prefLabel "asserted relation"@en ;
    skos:definition "The CCO/BFO property IRI that a structural assertion claims to hold (or not hold, in the case of negated assertions) between two entities."@en ;
    rdfs:domain :StructuralAssertion .


# =============================================================================
# ANNOTATION PROPERTIES — Ontology Match
# =============================================================================

:ontologyMatch
    a owl:AnnotationProperty ;
    rdfs:label "ontology match"@en ;
    skos:prefLabel "ontology match"@en ;
    skos:definition "An annotation linking a Tier 2 entity node to externally-matched ontology class metadata. Each entry records the matched class IRI, confidence score, evidence text, and class label. Added by buildGraph() when the ontology option is provided."@en .

:ontologyMatchIRI
    a owl:AnnotationProperty ;
    rdfs:label "ontology match IRI"@en ;
    skos:definition "The IRI of the ontology class or individual matched to this entity."@en ;
    rdfs:range rdfs:Resource .

:ontologyMatchConfidence
    a owl:AnnotationProperty ;
    rdfs:label "ontology match confidence"@en ;
    skos:definition "A decimal between 0.0 and 1.0 indicating the confidence of the ontology class match."@en ;
    rdfs:range xsd:decimal .

:ontologyMatchEvidence
    a owl:AnnotationProperty ;
    rdfs:label "ontology match evidence"@en ;
    skos:definition "The text token that triggered the ontology class match."@en ;
    rdfs:range xsd:string .

:ontologyMatchLabel
    a owl:AnnotationProperty ;
    rdfs:label "ontology match label"@en ;
    skos:definition "The human-readable label of the matched ontology class."@en ;
    rdfs:range xsd:string .

:ontologyMatchType
    a owl:AnnotationProperty ;
    rdfs:label "ontology match type"@en ;
    skos:definition "How the match was made: exact, alias, lemma, or hidden."@en ;
    rdfs:range xsd:string .

:ontologyMatchForm
    a owl:AnnotationProperty ;
    rdfs:label "ontology match form"@en ;
    skos:definition "The original input text form before any normalization was applied."@en ;
    rdfs:range xsd:string .

:ontologyMatchInflection
    a owl:AnnotationProperty ;
    rdfs:label "ontology match inflection"@en ;
    skos:definition "The normalization chain applied, e.g. plural->singular, possessive->base, verb->base, irregular."@en ;
    rdfs:range xsd:string .

:ontologyMatchOWLType
    a owl:AnnotationProperty ;
    rdfs:label "ontology match OWL type"@en ;
    skos:definition "The OWL category (owl:Class or owl:NamedIndividual) of the matched ontology entity."@en ;
    rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════════════
# REALIST DEONTIC MODELING (RDM) v1.2.1
# Added: 2026-03-27
# Spec: docs/development/realist-deontic-modeling-v1.2.1.md
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# RDM CLASSES (9)
# ─────────────────────────────────────────────────────────────────────────────────

:DirectiveInformationContentEntity rdf:type owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Directive Information Content Entity"@en ;
    skos:definition "An information content entity representing a normative speech act that prescribes, permits, or prohibits an act. Records the provenance of a directive (who said it, which modal marker) while the PlanSpecification it prescribes defines the content (what it requires)."@en ;
    rdfs:comment "Supersedes :DirectiveContent. The DICE is the speech act; the PlanSpecification is the specification."@en .

:PlanSpecification rdf:type owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Plan Specification"@en ;
    skos:definition "An information content entity describing the content of a prescribed act: the act type, prescribed agent, prescribed patient, and optionally a reference to a domain ontology act class. Does not instantiate the act."@en ;
    rdfs:comment "Defines the realization conditions of a deontic entity. A RealizableEntity links to its PlanSpecification via isSpecifiedBy."@en .

:Obligation rdf:type owl:Class ;
    rdfs:subClassOf bfo:BFO_0000017 ;  # bfo:RealizableEntity
    rdfs:label "Obligation"@en ;
    skos:definition "A realizable entity inhering in a bearer that prescribes performance of a specified act. Created at parse time with fulfillmentState Pending; transitions to Discharged when realized by an actual act, or Violated when the deadline passes or conditions are breached."@en .

:Permission rdf:type owl:Class ;
    rdfs:subClassOf bfo:BFO_0000017 ;  # bfo:RealizableEntity
    rdfs:label "Permission"@en ;
    skos:definition "A realizable entity inhering in a bearer that authorizes (but does not require) performance of a specified act."@en .

:Prohibition rdf:type owl:Class ;
    rdfs:subClassOf bfo:BFO_0000017 ;  # bfo:RealizableEntity
    rdfs:label "Prohibition"@en ;
    skos:definition "A realizable entity inhering in a bearer that forbids performance of a specified act. Violation occurs if the prohibited act is performed."@en .

:Intention rdf:type owl:Class ;
    rdfs:subClassOf bfo:BFO_0000017 ;  # bfo:RealizableEntity
    rdfs:label "Intention"@en ;
    skos:definition "A realizable entity inhering in a bearer representing a self-committed future act. Typically expressed via 'will' in regulatory text."@en .

:ConjunctiveObligation rdf:type owl:Class ;
    rdfs:subClassOf :Obligation ;
    rdfs:label "Conjunctive Obligation"@en ;
    skos:definition "An obligation composed of multiple conjunct obligations from coordinated verbs (e.g., 'shall review and approve'). Discharged only when ALL conjuncts are discharged. Subclasses Obligation so that queries for '?x a Obligation' automatically include compound obligations."@en .

:DeonticCategory rdf:type owl:Class ;
    rdfs:label "Deontic Category"@en ;
    skos:definition "An enumeration class for discrete deontic classifications. Instances represent categorically distinct speech acts (e.g., unconditional obligation vs. defeasible obligation), not points on a continuous scale."@en ;
    rdfs:comment "The interpretationConfidence property is separate and reflects parser certainty, not normative force."@en .

:FulfillmentState rdf:type owl:Class ;
    rdfs:label "Fulfillment State"@en ;
    skos:definition "An enumeration class for the lifecycle states of a realizable deontic entity: Pending (created, not yet discharged), Discharged (realized by an actual act), Violated (deadline passed or prohibited act performed)."@en .


# ─────────────────────────────────────────────────────────────────────────────────
# DEONTIC CATEGORY INDIVIDUALS (6)
# ─────────────────────────────────────────────────────────────────────────────────

:UnconditionalObligation rdf:type owl:NamedIndividual , :DeonticCategory ;
    rdfs:label "Unconditional Obligation"@en ;
    skos:definition "A non-defeasible duty. Typical modals: must, shall, have to, need to."@en ;
    :defaultConfidence 0.95 .

:DefeasibleObligation rdf:type owl:NamedIndividual , :DeonticCategory ;
    rdfs:label "Defeasible Obligation"@en ;
    skos:definition "A recommendation or overridable duty. Typical modals: should, ought to."@en ;
    :defaultConfidence 0.85 .

:DeclaredIntention rdf:type owl:NamedIndividual , :DeonticCategory ;
    rdfs:label "Declared Intention"@en ;
    skos:definition "A self-committed future act. Typical modal: will (in regulatory/legal context)."@en ;
    :defaultConfidence 0.75 .

:GrantedPermission rdf:type owl:NamedIndividual , :DeonticCategory ;
    rdfs:label "Granted Permission"@en ;
    skos:definition "An authorization to act. Typical modals: may, can."@en ;
    :defaultConfidence 0.70 .

:UnconditionalProhibition rdf:type owl:NamedIndividual , :DeonticCategory ;
    rdfs:label "Unconditional Prohibition"@en ;
    skos:definition "An absolute forbiddance. Typical modals: must not, shall not, may not, cannot."@en ;
    :defaultConfidence 0.90 .

# Hypothetical is dual-typed: both DeonticCategory (for RDM) and ActualityStatus (legacy)
:Hypothetical rdf:type owl:NamedIndividual , :DeonticCategory , :ActualityStatus ;
    rdfs:label "Hypothetical"@en ;
    skos:definition "A possible but non-actual scenario with no deontic force. Typical modals: could, would, might. No RealizableEntity is emitted for hypotheticals."@en ;
    :defaultConfidence 0.80 ;
    rdfs:comment "Dual-typed as both DeonticCategory and ActualityStatus for backward compatibility."@en .


# ─────────────────────────────────────────────────────────────────────────────────
# FULFILLMENT STATE INDIVIDUALS (3)
# ─────────────────────────────────────────────────────────────────────────────────

:Pending rdf:type owl:NamedIndividual , :FulfillmentState ;
    rdfs:label "Pending"@en ;
    skos:definition "The deontic entity exists and has not yet been discharged or violated. Set by TagTeam at parse time."@en .

:Discharged rdf:type owl:NamedIndividual , :FulfillmentState ;
    rdfs:label "Discharged"@en ;
    skos:definition "The deontic entity has been realized by an actual act. Set by downstream consumers via bfo:realizes assertion."@en .

:Violated rdf:type owl:NamedIndividual , :FulfillmentState ;
    rdfs:label "Violated"@en ;
    skos:definition "The deontic entity has been breached: deadline passed for obligation, or prohibited act performed. Set by downstream consumers."@en .


# ─────────────────────────────────────────────────────────────────────────────────
# RDM PROPERTIES — OBJECT PROPERTIES (12)
# ─────────────────────────────────────────────────────────────────────────────────

# NOTE: prescribes already exists in tagteam.ttl — UPDATE its domain/range in place:
# :prescribes rdf:type owl:ObjectProperty ;
#     rdfs:domain :DirectiveInformationContentEntity ;
#     rdfs:range :PlanSpecification ;
#     rdfs:label "prescribes"@en ;
#     skos:definition "Links a DirectiveInformationContentEntity to the PlanSpecification it prescribes."@en .

:isSpecifiedBy rdf:type owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000017 ;  # bfo:RealizableEntity
    rdfs:range :PlanSpecification ;
    rdfs:label "is specified by"@en ;
    skos:definition "Links a RealizableEntity (Obligation, Permission, etc.) directly to its PlanSpecification. Enables 3-hop queries from agent to act type: Agent → Obligation → PlanSpec → actType."@en .

:is_prescribed_by rdf:type owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000017 ;  # bfo:RealizableEntity
    rdfs:range :DirectiveInformationContentEntity ;
    rdfs:label "is prescribed by"@en ;
    skos:definition "Links a RealizableEntity to the DirectiveInformationContentEntity that prescribed it. Provides provenance: which document, which modal marker."@en .

:prescribedAgent rdf:type owl:ObjectProperty ;
    rdfs:domain :PlanSpecification ;
    rdfs:range bfo:BFO_0000004 ;  # bfo:IndependentContinuant
    rdfs:label "prescribed agent"@en ;
    skos:definition "The entity prescribed to perform the act. For passive voice, resolved from the oblique ('by X')."@en .

:prescribedPatient rdf:type owl:ObjectProperty ;
    rdfs:domain :PlanSpecification ;
    rdfs:range bfo:BFO_0000001 ;  # bfo:Entity
    rdfs:label "prescribed patient"@en ;
    skos:definition "The entity prescribed to undergo or receive the act."@en .

:prescribedRecipient rdf:type owl:ObjectProperty ;
    rdfs:domain :PlanSpecification ;
    rdfs:range bfo:BFO_0000004 ;  # bfo:IndependentContinuant
    rdfs:label "prescribed recipient"@en ;
    skos:definition "The entity prescribed as the recipient of the act (for ditransitive verbs)."@en .

:prescribedActClass rdf:type owl:ObjectProperty ;
    rdfs:domain :PlanSpecification ;
    rdfs:range owl:Class ;
    rdfs:label "prescribed act class"@en ;
    skos:definition "Optional reference to an OWL class in a domain ontology's act taxonomy. Convenience property for downstream consumers."@en .

:deonticCategory rdf:type owl:ObjectProperty ;
    rdfs:range :DeonticCategory ;
    rdfs:label "deontic category"@en ;
    skos:definition "The discrete deontic classification of a modal expression or deontic entity. Values are instances of DeonticCategory."@en ;
    rdfs:comment "Domain intentionally unspecified: used on VerbPhrase, DICE, and RealizableEntity nodes."@en .

:fulfillmentState rdf:type owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000017 ;  # bfo:RealizableEntity
    rdfs:range :FulfillmentState ;
    rdfs:label "fulfillment state"@en ;
    skos:definition "The lifecycle state of a deontic entity: Pending, Discharged, or Violated."@en .

:hasConjunct rdf:type owl:ObjectProperty ;
    rdfs:domain :ConjunctiveObligation ;
    rdfs:range :Obligation ;
    rdfs:label "has conjunct"@en ;
    skos:definition "Links a ConjunctiveObligation to each of its component Obligations. Range is Obligation (not Permission or Intention) per spec."@en .

:violationEvidence rdf:type owl:ObjectProperty ;
    rdfs:label "violation evidence"@en ;
    skos:definition "Links a Violated deontic entity to the evidence of its violation (e.g., the prohibited act that was performed)."@en .


# ─────────────────────────────────────────────────────────────────────────────────
# RDM PROPERTIES — DATATYPE PROPERTIES (5)
# ─────────────────────────────────────────────────────────────────────────────────

:prescribedActType rdf:type owl:DatatypeProperty ;
    rdfs:domain :PlanSpecification ;
    rdfs:range xsd:string ;
    rdfs:label "prescribed act type"@en ;
    skos:definition "The verb lemma of the prescribed act (e.g., 'review', 'approve', 'disclose')."@en .

:interpretationConfidence rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "interpretation confidence"@en ;
    skos:definition "Parser confidence in the deontic classification (0.0–1.0). Reflects parsing certainty, NOT normative force. 'Should' at 0.85 confidence is still categorically DefeasibleObligation, not 85% of an UnconditionalObligation."@en .

:disambiguationNote rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "disambiguation note"@en ;
    skos:definition "Human-readable note explaining classification ambiguity (e.g., 'Possible epistemic reading' for 'must be in pain')."@en .

:realizedAt rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "realized at"@en ;
    skos:definition "Timestamp when a deontic entity was discharged. Set by downstream consumers on transition to Discharged state."@en .

:violatedAt rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "violated at"@en ;
    skos:definition "Timestamp when a deontic entity was violated. Set by downstream consumers on transition to Violated state."@en .

:defaultConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain :DeonticCategory ;
    rdfs:range xsd:float ;
    rdfs:label "default confidence"@en ;
    skos:definition "The default interpretationConfidence assigned to this deontic category when no contextual disambiguation applies."@en .


# ─────────────────────────────────────────────────────────────────────────────────
# LEGACY DEPRECATION NOTES
# ─────────────────────────────────────────────────────────────────────────────────

# The following class is retained for backward compatibility but superseded by RDM.
# :DirectiveContent — DEPRECATED
# Superseded by: :DirectiveInformationContentEntity
# The old DirectiveContent emitted IntentionalAct nodes for modal verbs (ghost acts).
# The new DICE emits VerbPhrase + PlanSpecification + RealizableEntity per RDM v1.2.1.
# Existing consumers checking for DirectiveContent should migrate to DICE.

# NOTE: Update the existing :prescribes declaration in tagteam.ttl:
# - Change rdfs:domain from :DirectiveContent to :DirectiveInformationContentEntity
# - Add rdfs:range :PlanSpecification
# - The property remains for linking DICE → PlanSpec (was DICE → Act in legacy model)


# ═══════════════════════════════════════════════════════════════════════════════
# END RDM §9 BLOCK
# ═══════════════════════════════════════════════════════════════════════════════


# =============================================================================
# SMA LINGUISTIC SENSORY LAYER v1.2 — STATIVE PREDICATE CLASSES
# Added: 2026-03-29
# Spec: docs/sma-linguistic-sensory-layer-v1.2-final.md
# =============================================================================

# ─── Classes (3) ─────────────────────────────────────────────────────────────

:QualityAssertion rdf:type owl:Class ;
    rdfs:subClassOf :StructuralAssertion ;
    rdfs:label "Quality Assertion"@en ;
    skos:definition "A structural assertion that a continuant bears a quality. Emitted for adjectival copulars ('is hungry'), possessive statives ('has fur'), and evidential copulars ('seems tired'). Links to a bfo:Quality Tier 2 node via is_about."@en .

:RoleAssertion rdf:type owl:Class ;
    rdfs:subClassOf :StructuralAssertion ;
    rdfs:label "Role Assertion"@en ;
    skos:definition "A structural assertion that a continuant bears a role. Emitted for nominal copulars ('is a student'). Links to a bfo:Role Tier 2 node via is_about."@en .

:EpistemicStatus rdf:type owl:Class ;
    rdfs:label "Epistemic Status"@en ;
    skos:definition "An enumeration class for the certainty level of an assertion. Asserted = speaker states as fact. Observational = speaker reports an observation via evidential copula (seem, appear, look)."@en .

# ─── Epistemic Status Individuals (2) ────────────────────────────────────────

:Asserted rdf:type owl:NamedIndividual , :EpistemicStatus ;
    rdfs:label "Asserted"@en ;
    skos:definition "The speaker asserts the quality or state as fact."@en .

:Observational rdf:type owl:NamedIndividual , :EpistemicStatus ;
    rdfs:label "Observational"@en ;
    skos:definition "The speaker reports an observation via evidential copula (seem, appear, look, sound, feel). The quality is not asserted as absolute ground truth."@en .

# ─── Properties — Object Properties (3) ──────────────────────────────────────

:assertionSubject rdf:type owl:ObjectProperty ;
    rdfs:label "assertion subject"@en ;
    skos:definition "Links a QualityAssertion or RoleAssertion to the Tier 1 DiscourseReferent that is the subject of the assertion. IRI reference per FT-03."@en .

:grounding rdf:type owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000019 ;  # bfo:Quality
    rdfs:range :ActSpecification ;
    rdfs:label "grounding"@en ;
    skos:definition "Links a Quality to the ActSpecification (EventDescription or PlanSpecification) that causally grounds it. Populated by downstream services (CSS), not by TagTeam. Set to null at parse time."@en .

:epistemicStatus rdf:type owl:ObjectProperty ;
    rdfs:range :EpistemicStatus ;
    rdfs:label "epistemic status"@en ;
    skos:definition "The certainty level of an assertion or quality. Used on QualityAssertion and bfo:Quality nodes."@en ;
    rdfs:comment "Domain intentionally unspecified: used on both Tier 1 assertions and Tier 2 quality nodes."@en .

# ─── Properties — Datatype Properties (6) ────────────────────────────────────

:assertedQuality rdf:type owl:DatatypeProperty ;
    rdfs:domain :QualityAssertion ;
    rdfs:range xsd:string ;
    rdfs:label "asserted quality"@en ;
    skos:definition "The adjective lemma or quality noun extracted from the predicate (e.g., 'hungry', 'hot', 'fur')."@en .

:qualityType rdf:type owl:DatatypeProperty ;
    rdfs:domain bfo:BFO_0000019 ;  # bfo:Quality
    rdfs:range xsd:string ;
    rdfs:label "quality type"@en ;
    skos:definition "The quality type label on a Tier 2 Quality node. Same value as assertedQuality; downstream services map to rich taxonomy."@en .

:kindLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain bfo:BFO_0000019 ;  # bfo:Quality
    rdfs:range xsd:boolean ;
    rdfs:label "kind level"@en ;
    skos:definition "True if this quality is asserted at the kind level (generic subject, e.g., 'Dogs have fur'). False or absent for instance-level qualities."@en .

:observedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain bfo:BFO_0000019 ;  # bfo:Quality
    rdfs:range xsd:dateTime ;
    rdfs:label "observed at"@en ;
    skos:definition "Parse timestamp for state observation. Records when TagTeam extracted this quality."@en .

:evidentialMarker rdf:type owl:DatatypeProperty ;
    rdfs:domain :QualityAssertion ;
    rdfs:range xsd:string ;
    rdfs:label "evidential marker"@en ;
    skos:definition "The perception verb lemma that signals evidential modality (e.g., 'seem', 'appear', 'look'). Absent for non-evidential assertions."@en .

:copulaLemma rdf:type owl:DatatypeProperty ;
    rdfs:domain :StructuralAssertion ;
    rdfs:range xsd:string ;
    rdfs:label "copula lemma"@en ;
    skos:definition "The copula verb lemma from the source sentence (e.g., 'be' for 'is', 'seem' for 'seems')."@en .


# =============================================================================
# WS-C: EVENT DESCRIPTION + ACT SPECIFICATION
# Added: 2026-03-29
# Spec: docs/sma-linguistic-sensory-layer-v1.2-final.md §4
# =============================================================================

# ─── Classes (3) ─────────────────────────────────────────────────────────────

:ActSpecification rdf:type owl:Class ;
    rdfs:subClassOf cco:InformationContentEntity ;
    rdfs:label "Act Specification"@en ;
    skos:definition "An abstract superclass for ICEs that specify the structure of an act (agent, patient, act type) without asserting its realization or obligation status. Enables structural matching between PlanSpecification (deontic) and EventDescription (narrative)."@en .

:EventDescription rdf:type owl:Class ;
    rdfs:subClassOf :ActSpecification ;
    rdfs:label "Event Description"@en ;
    skos:definition "An ICE describing an act that DID occur (realizationStatus: Realized) or DID NOT occur (realizationStatus: Unrealized). Used in narrative contexts. The actual BFO Process (if realized) is linked via describedBy."@en .

:RealizationStatus rdf:type owl:Class ;
    rdfs:label "Realization Status"@en ;
    skos:definition "An enumeration class for whether a described event actually occurred: Realized or Unrealized."@en .

# ─── Update PlanSpecification superclass ─────────────────────────────────────
# NOTE: PlanSpecification already declared in RDM block.
# Add subClassOf ActSpecification (additive, not breaking).
# OWL allows multiple subClassOf declarations.
:PlanSpecification rdfs:subClassOf :ActSpecification .

# ─── Realization Status Individuals (2) ──────────────────────────────────────

:Realized rdf:type owl:NamedIndividual , :RealizationStatus ;
    rdfs:label "Realized"@en ;
    skos:definition "The described event occurred. An IntentionalAct (BFO Process) exists and is linked via describedBy."@en .

:Unrealized rdf:type owl:NamedIndividual , :RealizationStatus ;
    rdfs:label "Unrealized"@en ;
    skos:definition "The described event did not occur. No IntentionalAct is emitted. Used for negated narratives (WS-B)."@en .

# ─── Properties (5) ──────────────────────────────────────────────────────────

:actType rdf:type owl:DatatypeProperty ;
    rdfs:domain :ActSpecification ;
    rdfs:range xsd:string ;
    rdfs:label "act type"@en ;
    skos:definition "The verb lemma of the described or prescribed act (e.g., 'feed', 'review', 'disclose'). Shared across EventDescription and PlanSpecification."@en .

:agent rdf:type owl:ObjectProperty ;
    rdfs:domain :ActSpecification ;
    rdfs:label "agent"@en ;
    skos:definition "The entity that performs (or would perform) the act. On EventDescription, this is the actual agent. On PlanSpecification, use prescribedAgent instead."@en .

:patient rdf:type owl:ObjectProperty ;
    rdfs:domain :ActSpecification ;
    rdfs:label "patient"@en ;
    skos:definition "The entity that undergoes (or would undergo) the act."@en .

:realizationStatus rdf:type owl:ObjectProperty ;
    rdfs:domain :EventDescription ;
    rdfs:range :RealizationStatus ;
    rdfs:label "realization status"@en ;
    skos:definition "Whether the described event actually occurred (Realized) or did not occur (Unrealized)."@en .

:describedBy rdf:type owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000015 ;  # bfo:Process
    rdfs:range :EventDescription ;
    rdfs:label "described by"@en ;
    skos:definition "Links an actual BFO Process to the EventDescription ICE that describes it. Only present when realizationStatus is Realized."@en .


# =============================================================================
# END OF ONTOLOGY
# =============================================================================
